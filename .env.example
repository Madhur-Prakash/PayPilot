# ==============================================================================
# PayPilot - environment configuration
# Copy to .env  ->  cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------ App
APP_ENV = "YOUR_APP_ENV"
APP_NAME = "YOUR_APP_NAME"
APP_VERSION = "YOUR_APP_VERSION"
DEBUG = "YOUR_DEBUG"
LOG_LEVEL = "YOUR_LOG_LEVEL"
LOG_FORMAT = "YOUR_LOG_FORMAT"
LOG_CONSOLE_LOGIFYX = "YOUR_LOG_CONSOLE_LOGIFYX"

# ------------------------------------------------------------------ Database
# Local docker postgres (pgvector enabled) - started by `make db`
DATABASE_URL = "YOUR_DATABASE_URL"
# Supabase (production-style). Use the *session* connection string.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_ECHO = "YOUR_DB_ECHO"
DB_POOL_SIZE = "YOUR_DB_POOL_SIZE"
DB_MAX_OVERFLOW = "YOUR_DB_MAX_OVERFLOW"

# ------------------------------------------------------------------ Auth / JWT
# Generate one:  python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET = "YOUR_JWT_SECRET"
JWT_ALGORITHM = "YOUR_JWT_ALGORITHM"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = "YOUR_JWT_ACCESS_TOKEN_EXPIRE_MINUTES"
JWT_REFRESH_TOKEN_EXPIRE_DAYS = "YOUR_JWT_REFRESH_TOKEN_EXPIRE_DAYS"
REFRESH_COOKIE_NAME = "YOUR_REFRESH_COOKIE_NAME"
REFRESH_COOKIE_SECURE = "YOUR_REFRESH_COOKIE_SECURE"
REFRESH_COOKIE_SAMESITE = "YOUR_REFRESH_COOKIE_SAMESITE"

# ------------------------------------------------------------------ LLM (Groq)
GROQ_API_KEY = "YOUR_GROQ_API_KEY"
GROQ_MODEL = "YOUR_GROQ_MODEL"
GROQ_FALLBACK_MODEL = "YOUR_GROQ_FALLBACK_MODEL"
GROQ_TIMEOUT_SECONDS = "YOUR_GROQ_TIMEOUT_SECONDS"
GROQ_MAX_RETRIES = "YOUR_GROQ_MAX_RETRIES"
GROQ_TEMPERATURE = "YOUR_GROQ_TEMPERATURE"
GROQ_MAX_TOKENS = "YOUR_GROQ_MAX_TOKENS"

# ------------------------------------------------------------------ Embeddings
# hash = deterministic local embedding, zero external calls (default / offline safe)
EMBEDDING_PROVIDER = "YOUR_EMBEDDING_PROVIDER"
EMBEDDING_MODEL = "YOUR_EMBEDDING_MODEL"
EMBEDDING_DIMENSIONS = "YOUR_EMBEDDING_DIMENSIONS"

# ------------------------------------------------------------------ Langfuse
LANGFUSE_SECRET_KEY = "YOUR_LANGFUSE_SECRET_KEY"
LANGFUSE_PUBLIC_KEY = "YOUR_LANGFUSE_PUBLIC_KEY"
LANGFUSE_BASE_URL = "YOUR_LANGFUSE_BASE_URL"
LANGFUSE_ENABLED = "YOUR_LANGFUSE_ENABLED"

# ------------------------------------------------------------------ Vapi (voice)
# Dashboard -> API Keys.  Public key is browser-safe; private key never is.
VAPI_PUBLIC_KEY = "YOUR_VAPI_PUBLIC_KEY"
VAPI_PRIVATE_KEY = "YOUR_VAPI_PRIVATE_KEY"
VAPI_ASSISTANT_ID = "YOUR_VAPI_ASSISTANT_ID"
# Shared secret for the assistant's Server URL:
#   POST {BACKEND_URL}/api/v1/voice/server
# Configure it in Vapi as a credential on the assistant's server config. Any of
# the three documented schemes is accepted:
#   1. Bearer token   Authorization: Bearer <VAPI_WEBHOOK_SECRET>   (recommended)
#   2. Legacy header  X-Vapi-Secret: <VAPI_WEBHOOK_SECRET>
#   3. HMAC           <VAPI_SIGNATURE_HEADER>: hex HMAC of the raw body
# Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
VAPI_WEBHOOK_SECRET = "YOUR_VAPI_WEBHOOK_SECRET"
# Only used for the HMAC scheme; leave as-is for bearer or X-Vapi-Secret.
VAPI_SIGNATURE_HEADER = "YOUR_VAPI_SIGNATURE_HEADER"
VAPI_SIGNATURE_ALGORITHM = "YOUR_VAPI_SIGNATURE_ALGORITHM"

# ------------------------------------------------------------------ n8n
# Where the backend posts inventory domain events. Blank disables delivery:
# events are still recorded, just marked SKIPPED rather than retried forever.
N8N_INVENTORY_WEBHOOK_URL = "YOUR_N8N_INVENTORY_WEBHOOK_URL"
# Shared secret, signed both directions. Without it the inbound webhook rejects
# everything, so the automation fails closed.
N8N_WEBHOOK_SECRET = "YOUR_N8N_WEBHOOK_SECRET"
N8N_BASE_URL = "YOUR_N8N_BASE_URL"
N8N_API_KEY = "YOUR_N8N_API_KEY"
# How n8n (inside Docker) reaches this backend (on the host).
N8N_BACKEND_URL_FOR_N8N = "YOUR_N8N_BACKEND_URL_FOR_N8N"
# Baked into the nightly sweep workflow, which has no request to infer it from.
PGA_MERCHANT_ID = "YOUR_PGA_MERCHANT_ID"
# How often the backend delivers queued inventory events to n8n. This relay is
# the only thing that carries a stock change out to the automation, and the only
# thing that retries a failed delivery.
INVENTORY_DISPATCH_INTERVAL_SECONDS = "YOUR_INVENTORY_DISPATCH_INTERVAL_SECONDS"

# ------------------------------------------------------------------ Email (Gmail API)
# A single base64 line holding a pickled google.oauth2.credentials.Credentials
# scoped to gmail.send only - it can send, it cannot read the mailbox.
#
# Mint it once:
#   1. Google Cloud console -> enable the Gmail API
#   2. OAuth consent screen -> add yourself as a test user, then PUBLISH the app
#      (while it is in Testing, Google expires refresh tokens after 7 days)
#   3. Credentials -> OAuth client ID -> Desktop app -> save as backend/credentials.json
#   4. cd backend && .venv/Scripts/python.exe scripts/mint_gmail_token.py
#
# Leave it blank and email is written to the log instead of sent, including the
# temporary password - which is how the invite flow works with no credentials.
GMAIL_CREDENTIALS_B64 = "YOUR_GMAIL_CREDENTIALS_B64"
# The authorised mailbox. Optional (Gmail fills it in), but setting it is what
# gives the From header a display name.
GMAIL_SENDER = "YOUR_GMAIL_SENDER"
EMAIL_FROM_NAME = "YOUR_EMAIL_FROM_NAME"

# ------------------------------------------------------------------ Supabase
SUPABASE_URL = "YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY"

# ------------------------------------------------------------------ External signals
EXTERNAL_SEARCH_PROVIDER = "YOUR_EXTERNAL_SEARCH_PROVIDER"
TAVILY_API_KEY = "YOUR_TAVILY_API_KEY"

# ------------------------------------------------------------------ Networking
FRONTEND_URL = "YOUR_FRONTEND_URL"
BACKEND_URL = "YOUR_BACKEND_URL"
CORS_ORIGINS = "YOUR_CORS_ORIGINS"
RATE_LIMIT_ENABLED = "YOUR_RATE_LIMIT_ENABLED"
RATE_LIMIT_REQUESTS = "YOUR_RATE_LIMIT_REQUESTS"
RATE_LIMIT_WINDOW_SECONDS = "YOUR_RATE_LIMIT_WINDOW_SECONDS"

# ------------------------------------------------------------------ Demo seed
SEED_RANDOM_SEED = "YOUR_SEED_RANDOM_SEED"
DEMO_OWNER_EMAIL = "YOUR_DEMO_OWNER_EMAIL"
DEMO_OWNER_PASSWORD = "YOUR_DEMO_OWNER_PASSWORD"
DEMO_MERCHANT_NAME = "YOUR_DEMO_MERCHANT_NAME"

# ------------------------------------------------------------------ Agent memory (cognee)
# Long-term memory for the growth agents: what was recommended, what a human
# approved, and what an experiment actually proved. Off by default because
# building the knowledge graph costs LLM tokens on every agent run.
MEMORY_ENABLED = "YOUR_MEMORY_ENABLED"
# The LLM cognee uses to extract entities and relationships.
# "custom" is what cognee's docs specify for Groq: it routes through litellm and
# resolves the endpoint from the "groq/" model prefix, so no endpoint is needed.
# Leave the model and key blank to reuse GROQ_MODEL and GROQ_API_KEY from above.
MEMORY_LLM_PROVIDER = "YOUR_MEMORY_LLM_PROVIDER"
MEMORY_LLM_MODEL = "YOUR_MEMORY_LLM_MODEL"
MEMORY_LLM_API_KEY = "YOUR_MEMORY_LLM_API_KEY"
# Embeddings run locally through fastembed - no API key, no data leaving the
# host. cognee's own default is "hash", which is not semantic and recalls badly.
MEMORY_EMBEDDING_PROVIDER = "YOUR_MEMORY_EMBEDDING_PROVIDER"
MEMORY_EMBEDDING_MODEL = "YOUR_MEMORY_EMBEDDING_MODEL"
MEMORY_EMBEDDING_DIMENSIONS = "YOUR_MEMORY_EMBEDDING_DIMENSIONS"
# Where the graph, vectors and metadata live. Blank means backend/.cognee;
# without it cognee writes inside site-packages.
MEMORY_STORAGE_DIR = "YOUR_MEMORY_STORAGE_DIR"
# How many prior conclusions to pull into an agent run.
MEMORY_RECALL_TOP_K = "YOUR_MEMORY_RECALL_TOP_K"
# Recall enriches an answer; it is never allowed to delay one.
MEMORY_RECALL_TIMEOUT_SECONDS = "YOUR_MEMORY_RECALL_TIMEOUT_SECONDS"
MEMORY_WRITE_TIMEOUT_SECONDS = "YOUR_MEMORY_WRITE_TIMEOUT_SECONDS"
# cognee ships its own OpenTelemetry tracing to Langfuse. Left off so it cannot
# quietly duplicate the tracing this app already does.
MEMORY_TRACING_ENABLED = "YOUR_MEMORY_TRACING_ENABLED"

# ------------------------------------------------------------------ Frontend (Next.js public vars)
NEXT_PUBLIC_API_URL = "YOUR_NEXT_PUBLIC_API_URL"
NEXT_PUBLIC_APP_NAME = "YOUR_NEXT_PUBLIC_APP_NAME"
NEXT_PUBLIC_VAPI_PUBLIC_KEY = "YOUR_NEXT_PUBLIC_VAPI_PUBLIC_KEY"
NEXT_PUBLIC_VAPI_ASSISTANT_ID = "YOUR_NEXT_PUBLIC_VAPI_ASSISTANT_ID"
NEXT_PUBLIC_DEMO_EMAIL = "YOUR_NEXT_PUBLIC_DEMO_EMAIL"
NEXT_PUBLIC_DEMO_PASSWORD = "YOUR_NEXT_PUBLIC_DEMO_PASSWORD"