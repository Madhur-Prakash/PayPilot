# ==============================================================================
# PayPilot - environment configuration
# One file for the whole project (backend + frontend read it). Copy it with
# `make env` - the copy works as-is: every secret is blank, so the app runs with
# deterministic agents and a simulated PayPal, clearly labelled as such.
# ==============================================================================

# ------------------------------------------------------------------ App
APP_ENV=development
APP_NAME=paypilot
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_CONSOLE_LOGIFYX=true

# ------------------------------------------------------------------ Database
# docker-compose's Postgres 16 + pgvector listens on 5433 (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5433/autopilot
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------ Auth / JWT
# Change this for anything that is not your laptop.
JWT_SECRET=insecure-development-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=pga_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------ LLM (Groq, optional)
# Blank = deterministic mode: every figure, recommendation and negotiation still
# works; only the prose is simpler. Runs are labelled "Deterministic mode".
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048

# ------------------------------------------------------------------ Embeddings
# "hash" needs nothing; "fastembed" runs a local ONNX model (requirements-optional.txt).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ------------------------------------------------------------------ Agent memory (pgvector)
# Stored in Postgres (agent_memories, HNSW cosine index). No extra service.
MEMORY_ENABLED=true
MEMORY_RECALL_TOP_K=6
MEMORY_RECALL_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------ PayPal
# Blank credentials = simulator: SIM- identifiers, every row labelled SIMULATED.
# For the sandbox: create a REST app at developer.paypal.com -> Apps & Credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal assigns when you register https://<backend>/api/v1/paypal/webhooks.
# Without it, real webhooks are rejected (fail closed).
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=
PAYPAL_TIMEOUT_SECONDS=30
PAYPAL_MAX_RETRIES=2
PAYPAL_SIMULATION_ENABLED=true
PAYPAL_BRAND_NAME=PayPilot
DEFAULT_CURRENCY=USD
# Signs simulator webhooks (blank derives one from JWT_SECRET).
PAYPAL_SIMULATOR_WEBHOOK_SECRET=
# Optional: a sandbox *business* account email that seeded supplier agents use as
# their PayPal payee, so supplier payments complete end to end in the sandbox.
PAYPAL_SANDBOX_PAYEE_EMAIL=

# ------------------------------------------------------------------ Supply agents
# HMAC key for agent-to-agent protocol messages (blank derives one from JWT_SECRET).
AGENT_PROTOCOL_SECRET=
PROCUREMENT_MAX_NEGOTIATION_ROUNDS=4
PROCUREMENT_QUOTE_TTL_HOURS=48
PROCUREMENT_DEFAULT_TARGET_MARGIN=0.40
PROCUREMENT_PRICE_TOLERANCE_PCT=0.02
PROCUREMENT_TOTAL_TOLERANCE_AMOUNT=1.00

# ------------------------------------------------------------------ Inventory automation
INVENTORY_AUTOMATION_ENABLED=true
INVENTORY_DRY_RUN=false
# Automatic reorders at or above this value (USD) wait for a human approval.
INVENTORY_APPROVAL_THRESHOLD=500
INVENTORY_DISPATCH_INTERVAL_SECONDS=15

# ------------------------------------------------------------------ Worker
# true = the API process relays outbox events itself; false = run `python -m app.worker`.
OUTBOX_RELAY_IN_PROCESS=true

# ------------------------------------------------------------------ Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ------------------------------------------------------------------ Vapi voice (optional)
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# Shared secret Vapi presents on server-URL requests (Bearer, X-Vapi-Secret or HMAC).
VAPI_WEBHOOK_SECRET=
VAPI_SIGNATURE_HEADER=x-vapi-signature
VAPI_SIGNATURE_ALGORITHM=sha256

# ------------------------------------------------------------------ n8n (optional)
# Blank URL disables delivery: events are recorded and marked SKIPPED.
N8N_INVENTORY_WEBHOOK_URL=
# Shared HMAC secret, both directions. Blank = inbound automation fails closed.
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
# How n8n (inside Docker) reaches this backend on the host.
N8N_BACKEND_URL_FOR_N8N=http://host.docker.internal:8000
# Baked into the nightly sweep workflow.
PGA_MERCHANT_ID=

# ------------------------------------------------------------------ Email (Gmail API, optional)
# Blank = emails are rendered to the log instead of sent. See docs/CONFIGURATION.md.
GMAIL_CREDENTIALS_B64=
GMAIL_SENDER=
EMAIL_FROM_NAME=PayPilot

# ------------------------------------------------------------------ Supabase (unused by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------ External signals
EXTERNAL_SEARCH_PROVIDER=seed
TAVILY_API_KEY=

# ------------------------------------------------------------------ Networking
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------ Demo seed
SEED_RANDOM_SEED=20240917
DEMO_OWNER_EMAIL=owner@juniperoak.com
DEMO_OWNER_PASSWORD=Autopilot@2024
DEMO_MERCHANT_NAME="Juniper & Oak Coffee"

# ------------------------------------------------------------------ Frontend (Next.js public vars)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=PayPilot
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
NEXT_PUBLIC_DEMO_EMAIL=owner@juniperoak.com
NEXT_PUBLIC_DEMO_PASSWORD=Autopilot@2024
